{
    "name": "GO LLamaIndex",
    "build": {
        "dockerfile": "../.docker/Dev.dockerfile",
        "target": "devcontainer",
        "context": "..",
        "args": {
            "DEV_USER_NAME": "dev"
        }
    },
    "mounts": [
        "source=${localEnv:HOME}/.claude,target=/home/dev/.claude,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.codeium,target=/home/dev/.codeium,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.cursor,target=/home/dev/.cursor,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.gemini,target=/home/dev/.gemini,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.windsurf,target=/home/dev/.windsurf,type=bind,consistency=cached",
        "source=${localWorkspaceFolder},target=/ws,type=bind,consistency=cached",
    ],
    // "workspaceMount": "source=${localWorkspaceFolder},target=/go-llamaindex,type=bind,consistency=cached",
    "workspaceFolder": "/ws",
    "remoteUser": "dev",
    "updateRemoteUserUID": true,
    // "overrideCommand": false,
    "customizations": {
        "vscode": {
            "extensions": [
                "golang.go",
                "ms-azuretools.vscode-docker",
                "ms-vscode.makefile-tools"
            ]
        },
        "settings": {
            "files.autoSave": "afterDelay",
            "files.autoSaveDelay": 100
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": true,
            "configureZshAsDefaultShell": true,
            "installOhMyZsh": true
        }
    },
    "forwardPorts": [],
    "containerEnv": {
        "OLLAMA_URL": "http://host.docker.internal:11434",
        "OLLAMA_MODEL": "llama3",
        "OPENAI_URL": "http://host.docker.internal:11434/v1"
    }
}
